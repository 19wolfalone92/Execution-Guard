{
  "name": "execution-guard",
  "main": "gateway.mjs",
  "compatibility_date": "2026-11-25",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "execution-guard-db",
      "database_id": "e7699170-b634-48ce-a3b0-733aedb9b898"
    }
  ],
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "d3767e65d3924038abb362c607a4dcf3"
    }
  ],
  "previews": {
    "vars": {
      "EG_AUTH_ENABLED": "false",
      "EG_ENVIRONMENT": "preview",
      "EG_PREVIEW_READY": "false"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "execution-guard-preview-db",
        "database_id": "657131f8-b0f4-47f3-ab3d-91840843f2db"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "OAUTH_KV",
        "id": "25a30c61f53b422fa11889babb147fd4"
      }
    ]
  }
}
